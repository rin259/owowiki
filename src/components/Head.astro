---
import DefaultHead from '@astrojs/starlight/components/Head.astro';
---

<script is:inline>
	try {
		document.documentElement.dataset.theme = 'dark';
		document.documentElement.style.colorScheme = 'dark';
		localStorage.setItem('starlight-theme', 'dark');
	} catch {}
</script>

<DefaultHead />

<meta name="color-scheme" content="dark" />
<meta name="theme-color" content="#070c15" />

<link
	rel="preload"
	as="image"
	href="/bg/owo-bg-1600.webp"
	imagesrcset="/bg/owo-bg-800.webp 800w, /bg/owo-bg-1600.webp 1600w"
	imagesizes="100vw"
	fetchpriority="high"
/>

<style is:inline>
	html,
	body {
		background-color: #070c15;
	}

	body {
		min-height: 100vh;
	}

	.page,
	main {
		position: relative;
		z-index: 1;
	}
</style>
